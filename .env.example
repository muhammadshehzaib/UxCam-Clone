# ── API ────────────────────────────────────────────────
API_PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://uxclone:uxclone@localhost:5432/uxclone

# Redis
REDIS_URL=redis://localhost:6379

# JWT secret for dashboard read API
DASHBOARD_JWT_SECRET=change-me-in-production

# ── Dashboard ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
DASHBOARD_API_URL=http://localhost:3001

# Dev dashboard token (matches DASHBOARD_JWT_SECRET above)
DASHBOARD_TOKEN=dev-dashboard-token

# ── Cloudinary (object storage for mobile screenshots) ──
# Leave blank to fall back to storing base64 image bytes in Postgres.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── MinIO (object storage for web DOM replays) ──
# Leave MINIO_ENDPOINT blank to keep DOM frames in Postgres (no object storage).
MINIO_ROOT_USER=uxclone
MINIO_ROOT_PASSWORD=uxclone-minio-secret
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=uxclone
MINIO_SECRET_KEY=uxclone-minio-secret
MINIO_BUCKET=uxclone-replays
